{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASC AutoPayroll",
  "version": "0.1.0",
  "identifier": "io.github.arenvista.ascautopayroll",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ASC AutoPayroll",
        "width": 1080,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "UMBC timesheet automation",
    "longDescription": "Scrapes TRAC attendance (or a weekly schedule), rounds it into billable hours, and fills the UMBC PeopleSoft timesheet in Firefox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
